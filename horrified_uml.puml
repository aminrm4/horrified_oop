  + virtual ~perk()
  + void save_game(const std::string)
  + void load_game(std::string, programm &)
}

abstract class monster_card {
  # int item_count
  # int dice_play
  # int move_left
  # std::string name_of_card
  --
  + {abstract} void event(std::vector<std::vector<int>> &map, std::vector<location *> &loc, programm &a)
  + void _strike(int dice_attack, int move, programm &bug, monster *monsters)
  + {abstract} void monster_strike(programm &bug, std::vector<monster *> &monsters)
  + void item_handler(programm &help_object)
  + int get_item_count()
  + int get_dice_play()
  + int get_move_count()
  + virtual ~monster_card()
  + void save_game(const std::string)
